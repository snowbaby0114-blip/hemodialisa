# =============================================================================
# HEMODIALYSIS MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# =============================================================================
#
# Copy this file to .env.local and fill in your actual values
# Command: cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local or any file containing actual secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Get these values from your Supabase project dashboard:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy the URL and anon/public key

# Your Supabase project URL
# Example: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Your Supabase anonymous/public key
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# OPTIONAL: SUPABASE SERVICE ROLE KEY (for admin operations)
# -----------------------------------------------------------------------------
# Only needed if you want to perform admin operations that bypass RLS
# WARNING: This key has full access to your database. Keep it secret!
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS
# -----------------------------------------------------------------------------
# Uncomment to disable Next.js telemetry
# NEXT_TELEMETRY_DISABLED=1

# Uncomment to enable verbose logging
# NEXT_PUBLIC_DEBUG=true

# -----------------------------------------------------------------------------
# PRODUCTION SETTINGS
# -----------------------------------------------------------------------------
# Your production domain (for CORS, redirects, etc.)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# SETUP INSTRUCTIONS
# -----------------------------------------------------------------------------
#
# 1. Create your Supabase account at https://supabase.com
#
# 2. Create a new project
#
# 3. Run the database migration:
#    - Go to SQL Editor in your Supabase dashboard
#    - Copy and paste the content from supabase/migrations/001_initial_schema.sql
#    - Run the migration
#
# 4. Get your credentials:
#    - Go to Settings > API in your Supabase dashboard
#    - Copy the Project URL → NEXT_PUBLIC_SUPABASE_URL
#    - Copy the anon/public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# 5. Copy this file:
#    cp .env.example .env.local
#
# 6. Fill in your actual values in .env.local
#
# 7. Start the development server:
#    npm run dev
#
# -----------------------------------------------------------------------------
